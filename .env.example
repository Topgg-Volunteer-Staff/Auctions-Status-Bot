DISCORD_TOKEN="YOUR_BOT_TOKEN"
DISCORD_CLIENT_ID="YOUR_BOT_CLIENT_ID"
DISCORD_GUILD_ID="YOUR_GUILD_ID"
ENVIRONMENT="DEVELOPMENT or PRODUCTION"
MONGODB=
# Optional: must be a token accepted by Top.gg's GraphQL service.
# Required for the "Open In Modpanel" reminder button to resolve the bot's internal ID.
GRAPHQL_API_TOKEN=
# Web server configuration for transcript viewing
WEB_SERVER_PORT=3000
TRANSCRIPT_DOMAIN="yourdomain.gg"
# Discord OAuth for transcript access control. Add
# https://<TRANSCRIPT_DOMAIN>/auth/callback as a redirect URI in the Discord
# developer portal for the DISCORD_CLIENT_ID application.
DISCORD_CLIENT_SECRET=
# Random string (32+ chars) used to sign transcript login cookies.
TRANSCRIPT_SESSION_SECRET=
